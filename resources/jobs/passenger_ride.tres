[gd_resource type="Resource" script_class="JobTemplate" format=3]

[ext_resource type="Script" path="res://scripts/jobs/JobTemplate.cs" id="1_tpl"]

[resource]
script = ExtResource("1_tpl")
TemplateId = "passenger"
PackageName = "Passenger Ride"
Description = "Bike taxi: the passenger waits only so long, and expects to arrive on time."
Color = Color(0.35, 0.85, 1, 1)
Cargo = 1
CustomerNames = PackedStringArray("Ms. Lan", "Mr. Minh", "Ms. Hoa", "Mr. Tuan", "Ms. Mai", "Mr. Hung", "Ms. Thao", "Mr. Nam", "Ms. Linh", "Mr. Duc", "Ms. Trang", "Mr. Khoa")
BaseReward = 18.0
RewardPerKm = 16.0
RewardVariance = 0.15
MinDistance = 1200.0
MaxDistance = 4500.0
IsTimed = true
PickupBaseTime = 15.0
PickupTimePerKm = 9.0
DeliveryBaseTime = 15.0
DeliveryTimePerKm = 8.0
LatePenalty = 0.3
TipTimeShare = 0.5
TipShare = 0.25
MinRating = 3.5
Weight = 2.5
