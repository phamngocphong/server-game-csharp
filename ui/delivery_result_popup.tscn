[node name="HSeparator" type="HSeparator" parent="Center/Panel/VBox"]
layout_mode = 2

[node name="DetailsGrid" type="GridContainer" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
