[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/Hud.cs" id="1_hud"]
[ext_resource type="Theme" path="res://resources/ui/ui_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/ui/StarRating.cs" id="3_stars"]

[node name="HUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_hud")

[node name="FlashRect" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
