[ext_resource type="Resource" path="res://resources/jobs/documents.tres" id="8_docs"]
[ext_resource type="Resource" path="res://resources/jobs/parcel.tres" id="9_parcel"]
[ext_resource type="Resource" path="res://resources/jobs/fragile_electronics.tres" id="10_electronics"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="11_hud"]
[ext_resource type="PackedScene" path="res://ui/job_board.tscn" id="12_board"]
[ext_resource type="PackedScene" path="res://ui/delivery_result_popup.tscn" id="13_popup"]
