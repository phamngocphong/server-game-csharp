[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Main.cs" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/city_map.tscn" id="2_map"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="3_player"]
[ext_resource type="Script" path="res://scripts/jobs/JobManager.cs" id="4_jobs"]
[ext_resource type="PackedScene" path="res://scenes/job_marker.tscn" id="5_marker"]
