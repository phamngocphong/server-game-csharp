[ext_resource type="Resource" path="res://resources/traffic/bicycle.tres" id="17_bicycle"]
[ext_resource type="Resource" path="res://resources/traffic/motorbike.tres" id="18_motorbike"]
[ext_resource type="Resource" path="res://resources/traffic/car.tres" id="19_car"]
[ext_resource type="Resource" path="res://resources/traffic/bus.tres" id="20_bus"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="CityMap" parent="." instance=ExtResource("2_map")]

[node name="Traffic" type="Node2D" parent="." node_paths=PackedStringArray("Map")]
script = ExtResource("15_traffic")
Map = NodePath("../CityMap")
VehicleTypes = Array[ExtResource("16_vehicle_data")]([ExtResource("17_bicycle"), ExtResource("18_motorbike"), ExtResource("19_car"), ExtResource("20_bus")])

[node name="Markers" type="Node2D" parent="."]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="JobManager" type="Node" parent="." node_paths=PackedStringArray("Map", "MarkersRoot")]
script = ExtResource("4_jobs")
Map = NodePath("../CityMap")
MarkersRoot = NodePath("../Markers")
MarkerScene = ExtResource("5_marker")
JobTemplates = Array[ExtResource("6_template")]([ExtResource("7_food"), ExtResource("8_docs"), ExtResource("9_parcel"), ExtResource("10_electronics"), ExtResource("14_passenger")])

[node name="UI" type="CanvasLayer" parent="."]

[node name="HUD" parent="UI" instance=ExtResource("11_hud")]

[node name="JobBoard" parent="UI" instance=ExtResource("12_board")]

[node name="DeliveryResultPopup" parent="UI" instance=ExtResource("13_popup")]
